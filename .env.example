# AgentTrust MCP — environment configuration
# Copy to .env and replace the placeholders. .env is gitignored.
# Do not commit real keys.

# Path to SQLite DB file. Defaults to ./agenttrust.db
AGENTTRUST_DB=./agenttrust.db

# Optional dev API key seeded on startup (free tier, 100 writes/day).
# When unset, no dev key is created. There is no shared default.
AGENTTRUST_DEV_KEY=replace-with-a-dev-key

# Required. Admin key for verify_agent and resolve_dispute.
# The server refuses to start, and admin actions fail, when this is missing.
# There is no default.
AGENTTRUST_ADMIN_KEY=replace-with-a-long-random-secret

# Public base URL used in 429 upgrade messages
AGENTTRUST_UPGRADE_URL=https://mcpize.com/agenttrust-mcp

# Server port (Railway injects PORT)
PORT=8000
